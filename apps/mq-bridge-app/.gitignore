# Generated by Cargo
# will have compiled files and executables
debug
target
test-results
ui/coverage
coverage
coverage/
*.lcov
coverage-final.json

.env

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

.DS_Store

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Untracked deliberately: it must carry an ABSOLUTE CARGO_TARGET_DIR for
# rust-analyzer (${workspaceFolder} expands to the window's first folder, not
# this repo, so it breaks when the sibling ../mq-bridge is open too).
.vscode/settings.json

snap.*
*.log
conf
db
benches/etl/results
benches/etl/meltano_project
benches/etl/bin
# Generated datasets (116 MiB at 1M rows) — regenerated by gen_bench_data.py.
benches/etl/data

/node_modules
/ui/node_modules
/target
/crates/desktop/gen
/coverage
config.yml
crates/core/static/assets/__vite-browser-external-*.js
