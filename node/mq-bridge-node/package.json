{
  "name": "mq-bridge",
  "version": "0.4.12",
  "description": "Node.js bindings for mq-bridge",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcomq/mq-bridge.git",
    "directory": "node/mq-bridge-node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "mq-bridge-package-plugin": "plugin-packaging.mjs"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "native.js",
    "native.d.ts",
    "plugin-packaging.mjs",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "napi": {
    "binaryName": "mq_bridge_node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --strip --js native.js --dts native.d.ts",
    "build:basic": "napi build --platform --release --strip --no-default-features --features \"basic middleware\" --js native.js --dts native.d.ts",
    "build:ci": "napi build --platform --no-default-features --features \"http middleware schema\" --js native.js --dts native.d.ts",
    "build:debug": "napi build --platform --js native.js --dts native.d.ts",
    "example": "node examples/http-handler.js",
    "bench:http": "node analysis/bench_http_native.js",
    "test": "node --test test/*.test.js",
    "sync-version": "node ../../scripts/sync-version.mjs",
    "create-npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts"
  },
  "optionalDependencies": {
    "mq-bridge-darwin-x64": "0.4.12",
    "mq-bridge-darwin-arm64": "0.4.12",
    "mq-bridge-linux-x64-gnu": "0.4.12",
    "mq-bridge-linux-arm64-gnu": "0.4.12",
    "mq-bridge-win32-x64-msvc": "0.4.12"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
